# ─── Copier ce fichier en .env pour le développement local ────────────────────
# En production (Cloudflare Pages), ces variables se déclarent dans
# Workers & Pages → siowparfumes → Settings → Variables and secrets,
# portée « Production », puis il faut RELANCER UN DÉPLOIEMENT :
# Vite les injecte au build, pas à l'exécution, et Cloudflare ne reconstruit
# pas tout seul quand une variable change.

# API backend
VITE_API_URL=http://localhost:5000/api

# ─── Pixels publicitaires ─────────────────────────────────────────────────────
# Laisser vide = tracking totalement désactivé (aucun script chargé).

# Meta (Facebook/Instagram) — Gestionnaire d'événements → Paramètres → ID du pixel
VITE_META_PIXEL_ID=

# TikTok — TikTok Ads Manager → Outils → Événements → Pixel ID
VITE_TIKTOK_PIXEL_ID=

# Devise envoyée avec les événements de valeur.
#
# ATTENTION — Meta N'ACCEPTE PAS DZD. Vérifié en console : le pixel répond
# « Parameter 'currency' is invalid for event 'Purchase' ». L'événement part
# quand même (il est compté), mais le montant n'est pas exploitable : pas de
# ROAS, pas d'optimisation sur la valeur d'achat.
#
# Pour un suivi de valeur exploitable, envoyer en USD :
#   VITE_PIXEL_CURRENCY=USD
#   VITE_PIXEL_RATE=130        ← combien de DZD valent 1 unité de la devise
# Les prix affichés sur le site restent en DZD, seule la valeur transmise
# aux pixels est convertie (12 500 DZD → 96.15 USD).
#
# Laisser DZD si tu préfères ne compter que le nombre de conversions.
VITE_PIXEL_CURRENCY=DZD
VITE_PIXEL_RATE=1

# Correspondance avancée : téléphone/nom/wilaya/commune du client, hachés en
# SHA-256 par les pixels avant tout envoi (rien ne part en clair). Améliore
# l'attribution. Mettre false pour la désactiver complètement.
#
# TikTok reçoit ces données dès la commande. Meta ne les accepte qu'au premier
# fbq('init') : elles sont donc mémorisées et appliquées à la visite suivante
# du même appareil.
VITE_PIXEL_ADVANCED_MATCHING=true

# true = charge les pixels et logue chaque événement dans la console, même en
# `npm run dev`. À laisser vide/false le reste du temps, sinon les tests
# polluent les statistiques.
VITE_PIXEL_DEBUG=
